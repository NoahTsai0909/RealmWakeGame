%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e70ba62dc9b7eb944b69285eeb6884c4, type: 3}
  m_Name: TooltipDatabase
  m_EditorClassIdentifier: Assembly-CSharp::TooltipDatabaseSO
  entries:
  - id: attack
    title: Attack
    description: Deals damage to the target's health or shield.
  - id: burn
    title: Burn
    description: Deals damage equal to the number of Burn stacks every second. Loses
      1 stack after each tick of damage.
  - id: poison
    title: Poison
    description: 'Deals damage equal to the number of Poison stacks every 2 seconds. '
  - id: shield
    title: Shield
    description: Grants temporary health that absorbs incoming damage.
  - id: heal
    title: Heal
    description: Restores missing health up to the target's maximum health.
  - id: slow
    title: Slow
    description: Reduces cooldown speed by 50%. Each stack lasts 1 second.
  - id: haste
    title: Haste
    description: Increases cooldown speed by 50%. Each stack lasts 1 second.
  - id: gold
    title: Gold
    description: Primary currency for purchasing.
  - id: energy
    title: Energy
    description: Units with energy require expending energy to use abilities.
  - id: maxhealth
    title: Max Health
    description: The maximum amount of health a unit can have.
  - id: crit
    title: Crit
    description: The % chance for an active ability to critically strike, dealing
      double damage or applying double the damaging status effects.
  - id: provision
    title: Provision
    description: The cost to field this unit in combat.
  - id: maxprovision
    title: Max Provision
    description: The maximum total Provision allowed in combat.
  - id: multicast
    title: Multicast
    description: The total number of times an active ability casts when used
  - id: common
    title: Common
    description: 'Rarity of a unit. From lowest to highest, the order of rarities
      is: Common, Uncommon, Rare, Epic.'
  - id: uncommon
    title: Uncommon
    description: 'Rarity of a unit. From lowest to highest, the order of rarities
      is: Common, Uncommon, Rare, Epic.'
  - id: rare
    title: Rare
    description: 'Rarity of a unit. From lowest to highest, the order of rarities
      is: Common, Uncommon, Rare, Epic.'
  - id: epic
    title: Epic
    description: 'Rarity of a unit. From lowest to highest, the order of rarities
      is: Common, Uncommon, Rare, Epic.'
  - id: playerhealth
    title: Player Health
    description: Once this reaches 0, the expedition ends!
  - id: day
    title: Day
    description: Each day consists of 3 events and 1 mandatory combat. Reach 12 days
      to successfully finish the expedition!
  - id: level
    title: Level
    description: Level up every time you reach 10 experience. Leveling up yields
      important rewards!
  - id: preview
    title: Preview
    description: Scout ahead and inspect the enemy formations!
  - id: adjacent
    title: Adjacent
    description: Adjacent units refer to the 4 units to the top, left, bottom, right
      of the target.
  - id: side
    title: Side
    description: Side units refer to the 2 units to the top and bottom of the target.
  - id: advance
    title: Advance
    description: Reduces the remaining cooldown by [X] seconds.
  - id: transform
    title: Transform
    description: 'Permanently replace a unit with a random other unit of the same
      rarity and provision. '
  - id: mutation
    title: Mutation
    description: 'An enhancement effect to a unit. A unit can only have one mutation
      at a time. '
  - id: lifesteal
    title: Lifesteal
    description: A unit with lifesteal heals itself for the same amount of damage
      it deals when it attacks.
  - id: experience
    title: Experience
    description: Sufficient experience will lead to a level up. Leveling up resets
      experience to 0.
  - id: consume
    title: Consume
    description: 'Drag and drop a consumable unit on top of another unit to consume
      it for its specified effect. '
  - id: previewRarity
    title: Preview Rarity
    description: 'Get a preview of the next rarity of this unit! '
  - id: disaster
    title: Disaster
    description: When the countdown reaches 0, the Realmwake ravages the battlefield.
      All units take damage every second, and this damage increases each second!
